# Copy this file to .env.local and fill in each value.
# On Vercel, add the same names under Settings > Environment Variables.

# Supabase > Project Settings > API Keys
# (If you connect Supabase through Vercel's integration, it fills these in for you
#  as NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY. The app accepts both.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# platform.claude.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Stripe > Developers > API keys, and the Price ID of your $12/month product
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Where the app lives. Optional on Vercel (it uses your production address automatically).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
